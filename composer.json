{
  "name": "flat/api",
  "description": "PHP client for the Flat REST API",
  "keywords": [
    "Music",
    "Music notation",
    "MusicXML",
    "MIDI",
    "OpenAPI",
    "Sheet music",
    "Music score"
  ],
  "homepage": "https://github.com/FlatIO/api-client-php",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "Flat Team",
      "homepage": "https://github.com/FlatIO/api-client-php/graphs/contributors"
    }
  ],
  "require": {
    "php": "^8.2",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "guzzlehttp/guzzle": "^7.4.5",
    "guzzlehttp/psr7": "^2.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.5",
    "overtrue/phplint": "^9.0",
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "Flat\\APIClient\\": "src/"
    },
    "classmap": [
      "src/"
    ]
  }
}
